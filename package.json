{
  "name": "rashta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An original arcade motorcycle combat racer set in Delhi at night.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "size": "vite build && node scripts/check-bundle-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run size"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
